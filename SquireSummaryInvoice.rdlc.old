<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>Data Source</DataSourceReference>
      <rd:DataSourceID>e5f4c1c6-xxxx-xxxx-xxxx-xxxxxxxxxxxx</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <Body>
    <ReportItems>
      <!-- Report Header -->
      <Textbox Name="CustomerHeader">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Fields!Customer_No_.Value &amp; " - " &amp; Fields!Customer_Name.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>0.1in</Top>
        <Left>0.1in</Left>
        <Height>0.3in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <Textbox Name="PostingDateHeader">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>= "Posting Date: " &amp; Fields!Posting_Date.Value</Value>
                <Style>
                  <FontSize>10pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>0.5in</Top>
        <Left>0.1in</Left>
        <Height>0.25in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <!-- Invoice Table -->
      <Tablix Name="InvoiceTable">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>2in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>2in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- Invoice Header Row -->
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="InvoiceNo">
                      <Value>=Fields!DocumentNo.Value</Value>
                      <Style>
                        <FontWeight>Bold</FontWeight>
                        <FontSize>10pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="InvoiceDate">
                      <Value>=Fields!DocumentDate.Value</Value>
                      <Style>
                        <FontSize>10pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="InvoiceTotal">
                      <Value>=Fields!Amount.Value</Value>
                      <Style>
                        <FontWeight>Bold</FontWeight>
                        <FontSize>10pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents/>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Detail Lines -->
            <TablixRow>
              <Height>0.2in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="LineDescription">
                      <Value>=Fields!Description.Value</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="LineQuantity">
                      <Value>=Fields!Quantity.Value</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="LineAmount">
                      <Value>=Fields!Amount.Value</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents/>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>

        <!-- Group by Invoice No. -->
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember>
              <Group Name="InvoiceGroup">
                <GroupExpressions>
                  <GroupExpression>=Fields!DocumentNo.Value</GroupExpression>
                </GroupExpressions>
              </Group>
              <TablixMembers>
                <TablixMember>
                  <Group Name="DetailGroup"/>
                </TablixMember>
              </TablixMembers>
            </TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>

        <DataSetName>Header</DataSetName>
        <Top>1in</Top>
        <Left>0.1in</Left>
        <Height>1in</Height>
        <Width>6.5in</Width>
      </Tablix>
    </ReportItems>
    <Height>5in</Height>
  </Body>
  <Width>6.75in</Width>
  <DataSets>
    <DataSet Name="Header">
      <Fields>
        <Field Name="Customer_No_">
          <DataField>Customer_No_</DataField>
          <rd:TypeName>String</rd:TypeName>
        </Field>
        <Field Name="Customer_Name">
          <DataField>Customer_Name</DataField>
          <rd:TypeName>String</rd:TypeName>
        </Field>
        <Field Name="Posting_Date">
          <DataField>Posting_Date</DataField>
          <rd:TypeName>DateTime</rd:TypeName>
        </Field>
        <Field Name="DocumentNo">
          <DataField>DocumentNo</DataField>
          <rd:TypeName>String</rd:TypeName>
        </Field>
        <Field Name="DocumentDate">
          <DataField>DocumentDate</DataField>
          <rd:TypeName>DateTime</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>String</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>Decimal</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>Decimal</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText/>
      </Query>
    </DataSet>
  </DataSets>
  <Page>
    <PageHeight>11in</PageHeight>
    <PageWidth>8.5in</PageWidth>
    <LeftMargin>0.5in</LeftMargin>
    <RightMargin>0.5in</RightMargin>
    <TopMargin>0.5in</TopMargin>
    <BottomMargin>0.5in</BottomMargin>
  </Page>
</Report>
