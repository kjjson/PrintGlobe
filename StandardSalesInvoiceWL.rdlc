                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox169">
                          <rd:DefaultName>Textbox169</rd:DefaultName>
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(CStr(Fields!RowType.Value)="Invoice" AND NOT IsNothing(Fields!Amount.Value), CDec(Fields!Amount.Value), CDec(0))) - Abs(Sum(IIF(CStr(Fields!RowType.Value)="Payment" AND NOT IsNothing(Fields!Amount.Value), CDec(Fields!Amount.Value), CDec(0))))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
