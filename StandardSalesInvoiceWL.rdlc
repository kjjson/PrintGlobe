                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIF(CStr(Fields!RowType.Value)="Invoice" AND NOT IsNothing(Fields!Amount.Value), CDec(Fields!Amount.Value), CDec(0))) - Code.SumRevShare() - Abs(Sum(IIF(CStr(Fields!RowType.Value)="Payment" AND NOT IsNothing(Fields!Amount.Value), CDec(Fields!Amount.Value), CDec(0))))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>None</Style>
                            </Border>
                            <TopBorder>
                              <Color>#3b9890</Color>
                              <Style>Double</Style>
                              <Width>2pt</Width>
                            </TopBorder>
                            <BottomBorder>
